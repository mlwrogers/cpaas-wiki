npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# -------------------
# Python
# -------------------
__pycache__/
*.pyc
.venv/

# Output of `npm pack`
*.tgz

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build / dist
dist/
build/
.cache/
.next/
.out/
.nyc_output/

# Coverage
coverage/
*.lcov

